{
  "name": "plaid-node-walkthrough",
  "version": "0.1.0",
  "description": "A sample app and accompanying walkthrough for the Plaid API.",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "watch": "nodemon index.js",
    "test": "jest",
    "test:unit": "jest __tests__/unit",
    "test:integration": "jest __tests__/integration --runInBand",
    "test:watch": "jest --watch"
  },
  "author": "developers@plaid.com",
  "repository": "https://github.com/plaid/quickstart",
  "license": "ISC",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.97.1",
    "@supabase/supabase-js": "^2.108.0",
    "bcryptjs": "^3.0.2",
    "body-parser": "^1.20.4",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^4.22.1",
    "jsonwebtoken": "^9.0.2",
    "moment": "^2.30.1",
    "nodemon": "^3.1.14",
    "pg": "^8.13.3",
    "plaid": "^42.1.0",
    "stripe": "^22.1.1",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "supertest": "^7.2.2"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/__tests__/**/*.test.js"
    ],
    "setupFiles": [
      "<rootDir>/__tests__/jest.setup.js"
    ],
    "testTimeout": 15000
  }
}

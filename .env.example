# ─────────────────────────────────────────────────────────────────────────
# Required to start the server. The process will not boot without these.
# ─────────────────────────────────────────────────────────────────────────

# Postgres connection string. The backend connects on startup and runs additive
# schema migrations against this database. NEVER point a local/dev process at a
# production database — it will run DDL there.
DATABASE_URL=

# Secret used to sign/verify customer + admin JWTs. No default — the server
# throws at startup if this is unset. Use a long random value: `openssl rand -hex 32`.
JWT_SECRET=

# Stripe secret key — the Stripe client is constructed at startup and throws if
# this is missing. https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=

# Anthropic API key — the Claude client (income classification) is constructed
# at startup and throws if this is missing. https://console.anthropic.com/
ANTHROPIC_API_KEY=

# ─────────────────────────────────────────────────────────────────────────
# Integrations & auth (needed for full functionality, not for boot)
# ─────────────────────────────────────────────────────────────────────────

# Plaid — bank verification. https://dashboard.plaid.com/team/keys
PLAID_CLIENT_ID=
PLAID_SECRET=
# 'sandbox' for fake test credentials, 'production' for real data.
PLAID_ENV=sandbox

# Stripe webhook signing secret — verifies incoming Stripe webhook signatures.
# https://dashboard.stripe.com/webhooks
STRIPE_WEBHOOK_SECRET=

# Shared admin token (x-admin-token header). Used by the GitHub Actions cron
# jobs and as an admin bootstrap. Keep secret.
ADMIN_TOKEN=

# Mailchimp audience tagging (welcome / waitlist / reminder emails). Optional —
# leave blank to disable Mailchimp calls (they short-circuit silently).
MAILCHIMP_API_KEY=
MAILCHIMP_LIST_ID=
MAILCHIMP_SERVER_PREFIX=

# ─────────────────────────────────────────────────────────────────────────
# Supabase Auth (customer + admin login). Project Settings → API.
# Until these are set the app uses the legacy email+password / token flow.
# ─────────────────────────────────────────────────────────────────────────
# Backend:
SUPABASE_URL=                 # project URL, used by the server-side admin client
SUPABASE_JWT_SECRET=          # HS256 secret to verify Supabase access tokens (API → JWT Settings)
SUPABASE_SERVICE_ROLE_KEY=    # service-role key for the admin API (set roles, import users). SECRET.
# Frontend (Vite — exposed to the browser):
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ─────────────────────────────────────────────────────────────────────────
# Optional
# ─────────────────────────────────────────────────────────────────────────

# Backend port (default 8000).
APP_PORT=8000

# Comma-separated SSNs that bypass format + dupe validation. TEST/DEV ONLY.
TEST_SSNS=
